{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../", // 👈 allows imports from sibling packages like shared
    "module": "CommonJS",
    "target": "ES2022",
    "moduleResolution": "node",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"], // ✅ keeps compilation scoped to just this package
  "exclude": ["node_modules", "dist"]
}
