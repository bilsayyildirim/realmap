.env
.env.local
.env.*.local
!.env.example

# Dependencies
node_modules/
.pnpm-store/
packages/client/node_modules/

# Build outputs (Vercel builds from source — don't commit dist)
packages/client/dist/
packages/scripts/dist/
packages/shared/dist/

# Python artifacts
__pycache__/
*.pyc
*.pyo
data/raw/*.bak
data/*.bak

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/settings.json
*.swp
*.swo

# Vercel
.vercel/

