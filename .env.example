# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX=places
ELASTICSEARCH_SHARDS=1
ELASTICSEARCH_REPLICAS=1

# Elasticsearch Connection Settings
ELASTICSEARCH_RETRY_ATTEMPTS=3
ELASTICSEARCH_RETRY_DELAY=2000
ELASTICSEARCH_REQUEST_TIMEOUT=30000

# Data Paths
CITIES_PATH=./data/cities.geojson
BOUNDARIES_PATH=./data/boundaries.geojson

# Batch Processing
BATCH_SIZE=100
BATCH_MAX_RETRIES=3
BATCH_RETRY_DELAY=1000

# Validation
POPULATION_MIN=0
POPULATION_MAX=50000000

# OpenAI (for extend-raw-data: AI curation of ingredients/cooking methods)
# Get key from https://platform.openai.com/api-keys — do not commit real key
REALMAP_OPENAI_API_KEY=
