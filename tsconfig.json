// realmap/tsconfig.json
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS", // default; overridden per package
    "moduleResolution": "node",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@realmap/*": ["./packages/*/src"],
      "@realmap/shared": ["./packages/shared/src"],
      "@realmap/shared/*": ["./packages/shared/src/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "include": [],
  "references": [
    { "path": "packages/shared" },
    { "path": "packages/server" },
    { "path": "packages/client" },
    { "path": "packages/scripts" }
  ]
}
